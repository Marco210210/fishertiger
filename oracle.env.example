# Use a domain for automatic HTTPS (advisor.example.com), or http://PUBLIC_IP.
SITE_ADDRESS=advisor.example.com

# Protects the whole application. Use long, unique values.
FISHERTIGER_USERNAME=admin
FISHERTIGER_PASSWORD=change-this-long-password

# Optional. Without it, paste the room link and let Fishertiger discover the
# active shard; with it, room settings and team names are resolved immediately.
FISHERTIGER_FANTALAB_TOKEN=

# Optional, recommended over the token above: a long-lived Firebase refresh
# token renews itself forever instead of expiring after about an hour. See
# ORACLE_DEPLOYMENT.md "FantaLab" for how to capture it and for the required
# FISHERTIGER_FANTALAB_FIREBASE_API_KEY (FantaLab's public Firebase project
# key — not secret, but kept out of git to avoid noisy secret-scanner alerts).
FISHERTIGER_FANTALAB_REFRESH_TOKEN=
FISHERTIGER_FANTALAB_FIREBASE_API_KEY=
