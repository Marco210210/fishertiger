# Use a domain for automatic HTTPS (advisor.example.com), or http://PUBLIC_IP.
SITE_ADDRESS=advisor.example.com

# Protects the whole application. Use long, unique values.
FISHERTIGER_USERNAME=admin
FISHERTIGER_PASSWORD=change-this-long-password

# Optional. Without it, paste the room link and let Fishertiger discover the
# active shard; with it, room settings and team names are resolved immediately.
FISHERTIGER_FANTALAB_TOKEN=
